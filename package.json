{
  "name": "caseboard",
  "version": "1.0.0",
  "description": "Detective investigation board for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "canvas",
    "investigation",
    "caseboard"
  ],
  "author": "YOKOSHIP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZekiTRR/CaseBoard.git"
  },
  "bugs": {
    "url": "https://github.com/ZekiTRR/CaseBoard/issues"
  },
  "homepage": "https://github.com/ZekiTRR/CaseBoard#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  }
}
